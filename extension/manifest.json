{
  "manifest_version": 3,
  "name": "OtherSMTP4Gmail",
  "version": "1.0.1",
  "description": "Gmailの作成画面からローカルSMTPプログラムで送信します。",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "OtherSMTP4Gmail"},
  "content_scripts": [
    {"matches": ["https://mail.google.com/*"], "js": ["page-token.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://mail.google.com/*"], "js": ["compose.js"], "css": ["compose.css"], "run_at": "document_idle"}
  ]
}
